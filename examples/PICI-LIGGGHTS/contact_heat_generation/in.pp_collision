# Two-particle contact heat-generation example and validation case.

atom_style      granular
atom_modify     map array
boundary        f f f
newton          off
communicate     single vel yes
units           si

region          domain block -0.02 0.02 -0.01 0.01 -0.01 0.01 units box
create_box      1 domain

create_atoms    1 single -0.006 0.0 0.0 units box
create_atoms    1 single  0.006 0.0 0.0 units box
set             atom 1 diameter 0.01 density 2500.0 vx  0.5
set             atom 2 diameter 0.01 density 2500.0 vx -0.5

neighbor        0.002 bin
neigh_modify    delay 0

fix             young all property/global youngsModulus peratomtype 5.0e6
fix             poisson all property/global poissonsRatio peratomtype 0.30
fix             restitution all property/global coefficientRestitution &
                peratomtypepair 1 0.50
fix             friction all property/global coefficientFriction &
                peratomtypepair 1 0.0

pair_style      gran model hertz tangential history &
                heating_normal_hertz on &
                heat_generation on &
                heat_generation_efficiency 1.0 &
                heat_partition_pp 0.5 &
                heat_generation_tracking on
pair_coeff      * *

fix             conductivity all property/global thermalConductivity &
                peratomtype 0.1
fix             capacity all property/global thermalCapacity peratomtype 100.0
fix             thermal all heat/gran initial_temperature 300.0
fix             integrate all nve/sphere

timestep        1.0e-6

compute         kinetic all ke
thermo_style    custom step atoms c_kinetic f_thermal &
                f_totalContactHeatPower
thermo          100
thermo_modify   lost error norm no

# energy.dat is intentionally written every step so that Qdot can be integrated
# with the rectangle rule used by the explicit temperature integrator.
fix             energy all ave/time 1 1 1 c_kinetic f_thermal &
                f_totalContactHeatPower file energy.dat

run             6000

write_dump      all custom final.dump id x vx f_Temp f_contactHeatSource &
                modify sort id
