atom_style granular
atom_modify map array
boundary f f f
newton off
communicate single vel yes
units si

region domain block -0.02 0.02 -0.01 0.01 -0.01 0.01 units box
create_box 1 domain
create_atoms 1 single -0.005 0.0 0.0 units box
create_atoms 1 single 0.00498 0.0 0.0 units box
set atom 1 diameter 0.01 density 2500.0
set atom 2 diameter 0.01 density 2500.0

group fixed id 1
group moving id 2

neighbor 0.001 bin
neigh_modify delay 0 every 1 check no

fix young all property/global youngsModulus peratomtype 5.0e6
fix poisson all property/global poissonsRatio peratomtype 0.30
fix restitution all property/global coefficientRestitution peratomtypepair 1 1.0
fix friction all property/global coefficientFriction peratomtypepair 1 0.0
fix adhesion all property/global workOfAdhesion peratomtypepair 1 0.10

pair_style gran model jkr/analytical tangential no_history
pair_coeff * *

fix prescribe moving move linear 0.01 0.0 0.0 units box

timestep 1.0e-6
thermo 100
thermo_style custom step atoms
thermo_modify lost error norm no

dump curve all custom 10 force_curve.dump id x y z fx fy fz vx vy vz
dump_modify curve sort id format "%d %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g %.17g"

run 3000
unfix prescribe
fix prescribe moving move linear -0.01 0.0 0.0 units box
run 3000
