# Two unequal spheres with mechanical granular contact overlaid with
# short-range hydrodynamic lubrication.

atom_style      granular
atom_modify     map array
boundary        f f f
newton          off
communicate     single vel yes
units           si

region          domain block 0.0 0.01 0.0 0.01 0.0 0.01 units box
create_box      1 domain
create_atoms    1 single 0.00400 0.00500 0.00500 units box
create_atoms    1 single 0.005195 0.00500 0.00500 units box

# The radii are 0.5 mm and 0.7 mm.  The centres are 5 micrometres closer
# than the sum of the radii, so the example starts with both contributions:
# the Hertz model sees a small overlap and lubrication clamps the gap to
# cutinner.
set             atom 1 diameter 0.0010 density 2500.0 vx  0.0010 vy  0.0002 omegaz  5.0
set             atom 2 diameter 0.0014 density 2500.0 vx -0.0007 vy -0.0001 omegaz -2.0

neighbor        0.0001 bin
neigh_modify    delay 0 every 1 check no

# Mechanical contact properties for pair_style gran.
fix             young all property/global youngsModulus peratomtype 5.0e6
fix             poisson all property/global poissonsRatio peratomtype 0.25
fix             restitution all property/global coefficientRestitution peratomtypepair 1 0.50
fix             friction all property/global coefficientFriction peratomtypepair 1 0.10

# The granular and lubrication forces are summed by hybrid/overlay.
# Here flagfld=0 isolates pairwise lubrication from background-fluid drag.
pair_style      hybrid/overlay gran model hertz tangential history lubricate/bmpoly 0.001 1 0 1.0e-6 5.0e-5 1 0
pair_coeff      * * gran
pair_coeff      * * lubricate/bmpoly

fix             integrate all nve/sphere
compute         kinetic all ke

timestep        1.0e-10
thermo          20
thermo_style    custom step atoms c_kinetic
thermo_modify   lost error norm no
dump            state all custom 20 granular_lubrication.dump id type x y z vx vy vz fx fy fz omegax omegay omegaz radius
dump_modify     state sort id

run             200
